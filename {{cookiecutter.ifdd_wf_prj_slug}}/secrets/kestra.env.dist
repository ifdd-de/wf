# Environment of the Kestra container for flows (env_file in both compose files).
# Not committed. Two kinds of entries are allowed here:
#
#   SECRET_<NAME>=<base64 of the value>
#       read in flows as {% raw %}{{ secret('<NAME>') }}{% endraw %}; Kestra decodes them at start.
#       Encode without a trailing newline:  printf '%s' 'value' | base64 -w0
#
#   ENV_<NAME>=<plain value>
#       read in flows as {% raw %}{{ envs.<name> }}{% endraw %} (name in lowercase).
#
# Nothing else: every variable here is visible to every flow and to every
# process the Process task runner starts.

# Git synchronisation Kestra -> Git (examples/flows/system_git_sync.yml).
# Token with write access to the content repository only.
SECRET_GIT_TOKEN=
ENV_GIT_URL=https://github.com/example/ifdd-wf-content.git
ENV_GIT_USERNAME=git
ENV_GIT_BRANCH=main

# Read access to ifdd-be for flows and notebooks
# (examples/flows/backend_product_count.yml): client credentials of the
# Keycloak client below, which may only read. The notebooks get these as
# environment variables IFDD_BE_URL, IFDD_OIDC_TOKEN_URL, IFDD_API_CLIENT_ID
# and IFDD_API_CLIENT_SECRET.
ENV_IFDD_BE_URL={{ cookiecutter.ifdd_be_url }}
ENV_IFDD_OIDC_TOKEN_URL={{ cookiecutter.ifdd_oidc_realm }}/protocol/openid-connect/token
ENV_IFDD_API_CLIENT_ID={{ cookiecutter.ifdd_keycloak_api_client_id }}
# Secret of that client (IFDD_KEYCLOAK_API_CLIENT_SECRET in keycloak/.env),
# base64; the meta repository copies it with
# copy_secrets.py ... kestra-secret:wf/secrets/kestra.env:IFDD_API_CLIENT_SECRET
SECRET_IFDD_API_CLIENT_SECRET=

# Network of task containers that call other services by name (flows set
# networkMode to it). {% if cookiecutter.ifdd_wf_docker_mode == "dind" %}With Docker-in-Docker: "host", the network of the dind
# container, which is on {{ cookiecutter.ifdd_proxy_network }}.{% else %}With the host socket: the proxy network itself.{% endif %}
ENV_TASK_NETWORK={% if cookiecutter.ifdd_wf_docker_mode == "dind" %}host{% else %}{{ cookiecutter.ifdd_proxy_network }}{% endif %}
